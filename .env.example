NODE_ENV=development
HOST=127.0.0.1
PORT=4173
LOCAL_PREMIUM_ACCESS=1
# Somente em desenvolvimento/testes: permite demonstrar a segunda etapa de login (sem e-mail).
# NUNCA use como segundo fator real.
OVBECK_DEMO_2FA=0

# Administrador inicial: preencha uma única vez no arquivo local .env (ignorado pelo Git).
# A senha inicial pode ser A1 somente em desenvolvimento local; o primeiro login exige troca.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_FULL_NAME=Administrador OVBECK
APP_ORIGIN=http://127.0.0.1:4173
# Segredo independente, mínimo de 32 bytes. Se não definido, instalações locais
# usam data/.registration-ip-hmac-secret; em produção defina este valor.
REGISTRATION_IP_HMAC_SECRET=
# DATABASE_PATH=/caminho/seguro/finance.sqlite

# Integração de pagamentos futura. Não configurar nesta etapa local; o checkout permanece desativado.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# APP_ORIGIN deve ser uma origem pública HTTPS com acesso ao endpoint /api/webhooks/mercadopago.
MP_API_BASE_URL=https://api.mercadopago.com
